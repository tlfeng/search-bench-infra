# 复制为 terraform.tfvars 后填写；或直接 `make setup` 自动生成——
# public_key 会自动填，operator_cidr 默认留空（make up 自动探测），本文件里只需再确认 oss_bucket

region  = "cn-hangzhou"
zone_id = "cn-hangzhou-i"

project = "esbench"
env     = "perf"
owner   = "perf-team"

# SSH 放行网段：**默认留空** —— 每次 make up / plan 自动探测本机出口 IP 并放行（/32），
# 宽带重拨/换网后重新 make up 即可刷新，无需手填。只有固定出口场景（公司网段/跳板机）
# 才取消注释填 CIDR；临时场景也可 make up OPERATOR_CIDR=1.2.3.0/24 覆盖。务必收紧，不要 0.0.0.0/0。
# operator_cidr = "203.0.113.10/32"

# SSH 公钥内容（推荐）；留空则改用 instance_password
public_key = "ssh-rsa AAAA..."

# ---------- 档位（机型与镜像的配套组合，由档位自动选镜像） ----------
# x86-cheap  x86 8C32G  <- 先用它跑通流程
# x86-main   x86 16C64G <- 主力档
# arm-cheap  ARM 8C32G
# arm-main   ARM 16C64G
profile = "x86-cheap"

# rally 客户端架构，独立于 ES：arm（默认，比同规格 x86 便宜约 23.5%，不影响服务端测量）
# 若实测 ARM 单核在服务端进入平台期前就吃满，改回 "x86"
rally_arch = "arm"

es_node_count = 2

# 想临时试别的机型可覆盖（留空则用档位默认）
es_instance_type_override    = ""
rally_instance_type_override = ""

# ---------- 镜像（按架构各存一份，档位自动选取） ----------
# 先用 make image-all PROFILE=x86-cheap 构建，把输出 ID 填到这里
es_image_id_x86    = ""
es_image_id_arm    = ""
rally_image_id_x86 = ""
rally_image_id_arm = ""

# ---------- 引擎 ----------
engine      = "elasticsearch"   # elasticsearch | easysearch
engine_home = "/opt/es"
es_heap_gb  = 16                # 与 geonames 基线一致
es_data_dir = "/data/es"
cluster_name = "esbench"
es_http_port = 9200

# ---------- 存储 ----------
# 注意：走 make up 时这几个值会被档位默认覆盖（debug/arm-debug 两档是 40G/40G），
# 下面的值只在直接 terraform apply 时生效。盘型统一 ESSD PL1（0.0021 元/GiB/时，
# 系统盘与数据盘同价；g8i/g8y 不支持高效云盘），存储费用见 README 2.4。
es_data_disk_size    = 100      # 语料 2.8G + merge 峰值 <10G，100G 足够
es_data_disk_pl      = "PL1"    # 350MB/s 稳定，不触发突发回落
rally_data_disk_size = 40       # 只放 rally 产物与日志
rally_data_disk_pl   = "PL1"

# ---------- 产物归档 ----------
oss_bucket = "my-esbench-results"
oss_prefix = "esrally-results"
ram_role_name = ""              # 建议配 RAM 角色免 AK 写 OSS

# ---------- 计费（按量 / 竞价） ----------
# use_spot 是全局开关，同时作用于 ES 节点与 rally 客户端；
# 要让两侧取值不同，用下面两个单侧变量覆盖（留空 = 跟随 use_spot）。
# 命令行也可以临时覆盖：make up USE_SPOT=1 / SPOT_ES=0 / SPOT_RALLY=1（见 README 2.2）
use_spot          = false       # 正式出报告的轮次保持 false
# es_use_spot     = false       # 例：ES 按量 + rally 竞价
# rally_use_spot  = true
assign_public_ip  = true        # false 时需经堡垒机访问

# 引擎 admin 密码（两引擎统一；镜像构建与开机健康检查共用同一个值。
# 9 位是 easysearch 密码策略的下限。改了它之后存量 ES 镜像要 FORCE=1 重建）
es_password = "Qwer@1234"
